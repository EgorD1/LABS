month = input().strip()

days_31 = ["January", "March", "May", "July", "August", "October", "December"]
days_30 = ["April", "June", "September", "November"]

if month == "February":
    print(f"{month} has 28 or 29 days in it.")
elif month in days_30:
    print(f"{month} has 30 days in it.")
elif month in days_31:
    print(f"{month} has 31 days in it.")